 {
  "id": 24933,
  "name": "Ziemassvētku sveču dāvanu komplekts “Mājiņa un dekoratīvās sveces”",
  "slug": "ziemassvetku-svecu-davanu-komplekts",
  "permalink": "https://marmarcandles.com/product/ziemassvetku-svecu-davanu-komplekts/",
